{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:20128/v1",
    "ANTHROPIC_AUTH_TOKEN": "YOUR_AUTH_TOKEN_HERE",
    "ANTHROPIC_API_KEY": "YOUR_API_KEY_HERE",
    "ANTHROPIC_MODEL": "campur",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "campur",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "campur",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "campur",
    "CLAUDE_CODE_EFFORT_LEVEL": "high",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1048576",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "900000",
    "API_TIMEOUT_MS": "600000",
    "CAVEMAN_DEFAULT_MODE": "caveman"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "campur",
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"~\\.claude\\hooks\\caveman-statusline.ps1\""
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "replica-skill@replica-skill": true,
    "andrej-karpathy-skills@karpathy-skills": true,
    "claude-code-setup@claude-plugins-official": true,
    "caveman@caveman": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "replica-skill": {
      "source": {
        "source": "github",
        "repo": "Jakeschincariol/replica-skill"
      }
    },
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "multica-ai/andrej-karpathy-skills"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "hasCompletedOnboarding": true
}
